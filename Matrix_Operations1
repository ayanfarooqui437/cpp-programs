#include <iostream>
using namespace std;

int main()
{
    int rows,cols;
    cout<<"What will be the Number of Rows ? ";
    cin>>rows;
   
    cout<<"What will be the Number of Coulmns ? ";
    cin>>cols;
    int A[rows][cols];
    int B[rows][cols];
    int C[rows][cols];
    int D[rows][cols];
    int E[rows][cols];
    int maximum1=A[0][0];
    int minimum1=A[0][0];
    int maximum2=B[0][0];
    int minimum2=B[0][0];
    int even = 0, odd = 0, sum=0;
    
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
        	cout<<"Enter the "<<"["<<i<<"]"<<"["<<j<<"]"<<" Element of the Matrix: "<<endl;
            cin >> A[i][j];
            sum+=A[i][j];
            if(A[i][j]>maximum1){
            	maximum1=A[i][j];
			}
			if(minimum1<A[i][j]){
				minimum1=A[i][j];
			}
            if(A[i][j] % 2 == 0)
                even++;
            else
                odd++;
        }
    }
    cout<<"Maximum of the Matrix 1: "<<maximum1<<endl;
    cout<<"Minimum of the Matrix 1: "<<minimum1<<endl;
    
    cout<<endl;
    cout<<"Transpose of the Matrix 1: ";
    for(int j=0;j<cols;j++){
    	cout<<"[ ";
    	for(int i=0;i<rows;i++){
    		cout<<A[i][j]<<" ";
    		
		}
		cout<<"]";
	}
	cout<<endl;
    for(int i=0;i<rows;i++){
    	cout << "[ ";
    	for(int j=0;j<cols;j++){	
    		cout<<A[i][j]<<" ";
		}
		cout << "] ";
		cout<<endl;
	}
	cout<<endl;
	for(int i =0;i<rows;i++){
		for(int j=0;j<cols;j++){
			cout<<"Enter the "<<"["<<i<<"]"<<"["<<j<<"]"<<" Element of the Matrix: "<<endl;
			cin>>B[i][j];
			if(maximum2<B[i][j]){
            	maximum2=B[i][j];
			}
			if(minimum2>B[i][j]){
				minimum2=B[i][j];
			}
		}
	}
	cout<<"Maximum of the Matrix 2: "<<maximum2<<endl;
    cout<<"Minimum of the Matrix 2: "<<minimum2<<endl;
	cout<<endl;
	cout<<"Transpose of the Matrix 2: ";
    for(int j=0;j<cols;j++){
    	cout<<"[ ";
    	for(int i=0;i<rows;i++){
    		cout<<B[i][j]<<" ";
    		
		}
		cout<<"]";
	}
	cout<<endl;
	for(int i=0;i<rows;i++){
		cout<<"[ ";
		for(int j=0;j<cols;j++){
			cout<<B[i][j]<<" ";
		}
		cout<<"]";
	}
	cout<<endl;
	for(int i = 0;i<rows;i++){
		for(int j = 0;j<cols;j++){
			C[i][j]=A[i][j]+B[i][j];
			D[i][j]=A[i][j]-B[i][j];	
		}
	}
	cout<<endl;
	for(int i = 0; i < rows; i++){
		for(int j=0;j<cols;j++){
			E[i][j]=0;
			for(int k =0;k<cols;k++){
				E[i][j]+=A[i][j]*B[i][j];
			}
		}
	}
    cout<<endl;
	cout<<"The Sum of the two "<<rows<<" x "<<cols<<" Matrices are: ";
	for(int i=0;i<rows;i++){
		cout<<"[ ";
		for(int j=0;j<cols;j++){
			cout<<C[i][j]<<" ";
		}
		cout<<"]";
	}
	cout<<endl;
	cout<<"The Difference of the two "<<rows<<" x "<<cols<<" Matrices are: ";
	for(int i=0;i<rows;i++){
		cout<<"[ ";
		for(int j=0;j<cols;j++){
			cout<<D[i][j]<<" ";
		}
		cout<<"]";
	}
	cout<<endl;
	cout<<"The Multiplication of the two "<<rows<<" x "<<cols<<" Matrices are: ";
	for(int i=0;i<rows;i++){
		cout<<"[ ";
		for(int j=0;j<cols;j++){
			cout<<E[i][j]<<" ";
		}
		cout<<"]";
	}
	cout<<endl;
    cout << "Number of Even Elements of the Matrix 1 = " << even << endl;
    cout << "Number of Odd Elements of the Matrix 1 = " << odd << endl;
    cout<<"Sum of All Elements of the Matrix 1 = "<< sum <<endl;
    return 0;
}
