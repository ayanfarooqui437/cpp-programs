#include <iostream>
#include <stack>
using namespace std;

int main()
{
    string postfix;
    cin >> postfix;

    stack<int> s;

    for(char ch : postfix)
    {
        if(isdigit(ch))
        {
            s.push(ch - '0');
        }
        else
        {
            int b = s.top(); s.pop();
            int a = s.top(); s.pop();

            switch(ch)
            {
                case '+': s.push(a+b); break;
                case '-': s.push(a-b); break;
                case '*': s.push(a*b); break;
                case '/': s.push(a/b); break;
            }
        }
    }

    cout << "Result = " << s.top();
}
