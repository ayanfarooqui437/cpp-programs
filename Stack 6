#include <iostream>
using namespace std;

#define SIZE 10

class TwoStacks
{
    int arr[SIZE];
    int top1, top2;

public:
    TwoStacks()
    {
        top1 = -1;
        top2 = SIZE;
    }

    void push1(int x)
    {
        if(top1 + 1 == top2)
        {
            cout << "Overflow\n";
            return;
        }
        arr[++top1] = x;
    }

    void push2(int x)
    {
        if(top1 + 1 == top2)
        {
            cout << "Overflow\n";
            return;
        }
        arr[--top2] = x;
    }

    void pop1()
    {
        if(top1 == -1)
            cout << "Underflow\n";
        else
            cout << arr[top1--] << endl;
    }

    void pop2()
    {
        if(top2 == SIZE)
            cout << "Underflow\n";
        else
            cout << arr[top2++] << endl;
    }
};

int main()
{
    TwoStacks s;

    s.push1(10);
    s.push1(20);

    s.push2(50);
    s.push2(60);

    s.pop1();
    s.pop2();

    return 0;
}
