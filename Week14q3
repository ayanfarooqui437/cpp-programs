#include <iostream>
using namespace std;

class Base
{
public:
    Base()
    {
        show();
    }

    virtual void show()
    {
        cout << "Base Class Function" << endl;
    }

    void display()
    {
        show();
    }
};

class Derived : public Base
{
public:
    void show()
    {
        cout << "Derived Class Function" << endl;
    }
};

int main()
{
    Derived d;

    cout << "Calling through member function:" << endl;
    d.display();

    return 0;
}
