/*Write a C++ program to define a structure named D.O.B., which contains
name,day, month and year. Using the concept of nested structures display your nameand
date of birth.*/
#include<iostream>
#include<string>

using namespace std;

struct DOB{
	int day;
	int month;
	int year;
};

struct person{
	string name;
	DOB birth;
};

void write(person &p){
	cout<<"Enter the Name of the Person:- ";
	getline(cin, p.name);
	
	cout<<"Enter the Day of the Birth:- ";
	cin>>p.birth.day;
	
	cout<<"Enter the Month of the Birth:- ";
	cin>>p.birth.month;
	
	cout<<"Enter the Year of the Birth:- ";
	cin>>p.birth.year;
}

void display(person p){
	cout<<"==========PERSON'S DETAILS=========="<<endl;
	cout<<"Name:- "<<p.name<<endl;
	cout<<"Date of Birth:- "<<p.birth.day<<"/"<<p.birth.month<<"/"<<p.birth.year<<endl;
}

int main(){
	person p1;
	
	write(p1);
	display(p1);
	return 0;
}
