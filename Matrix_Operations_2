#include<iostream>
using namespace std;
int row_sum(int a, int b){
	int A[a][b];
	
	for(int i=0;i<a;i++){
		for(int j=0;j<b;j++){
			cout<<"Enter the "<<"["<<i<<"]"<<"["<<j<<"]"<<" element of the Matrix: ";
			cin>>A[i][j];
		}
	}
	for(int i=0;i<a;i++){
		int sum=0;
		for(int j=0;j<b;j++){
			sum += A[i][j];
		}
		cout<<"Row "<<i+1<<" = "<<sum<<endl;
	}
}
int col_sum(int a, int b){
	int A[a][b];
	for(int i=0;i<a;i++){
		for(int j=0;j<b;j++){
			cout<<"Enter the "<<"["<<i<<"]"<<"["<<j<<"]"<<" element of the Matrix: ";
			cin>>A[i][j];
		}
	}
	for(int j=0;j<b;j++){
		int sum=0;
		for(int i=0;i<a;i++){
			sum+=A[i][j];
		}
		cout<<"Column "<<j+1<<" = "<<sum<<endl;
	}
}
int search(int a, int b){
	int A[a][b];
	for(int i = 0;i<a;i++){
		for(int j = 0;j<b;j++){
			cout<<"Enter the "<<"["<<i<<"]"<<"["<<j<<"]"<<" element of the Matrix: ";
			cin>>A[i][j];
		}
	}
	int element;
	cout<<"Enter the element to be searched:- ";
	cin>>element;
	bool found = false;
	for(int i=0;i<a;i++){
		for(int j=0;j<b;j++){
			if(A[i][j]==element){
				cout<<"Found at Row "<<i+1<<", Column "<<j+1<<endl;
				found = true;
			}
		}
	}
	if(!found){
		cout<<"Element NOT found in the Matrix!"<<endl;
	}
}
int main(){
	int rows, cols;
	cout<<"What will be the Number of Rows? ";
	cin>>rows;
	cout<<"What will be the Number of Columns? ";
	cin>>cols;
	row_sum(rows,cols);
	col_sum(rows,cols);
	search(rows,cols);
	return 0;
}
