#include<iostream>
#include<vector>

using namespace std;

//Create a Upper Triangular Matrix
vector<vector<int> >CreateUpperTriangular(int n){
	vector<vector<int> >matrix(n, vector<int>(n, 0));
	int val = 1;
	for(int i = 0;i < n; ++i){
		for(int j = i; j < n; ++j){
			matrix[i][j] = val++;
		}
	}
	return matrix;
}

void PrintUpperTriangularMatrix(const vector<vector<int> >& matrix){
	int n = matrix.size();
	
	for(int i = 0; i < n; ++i){
		cout<<"[ ";
		for(int j = 0; j < n; ++j){
			cout<<matrix[i][j]<<" ";
		}
		cout<<"]";
		cout<<endl;
	}
}

//Main Function
int main(){
	int n;
	cout<<"Enter the Size of the Matrix(N x N): ";
	cin>>n;
	
	vector<vector<int> > UpperMatrix = CreateUpperTriangular(n);
	
	PrintUpperTriangularMatrix(UpperMatrix);
	
	return 0;
}
