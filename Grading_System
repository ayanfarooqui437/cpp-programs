#include<iostream>
using namespace std;
int main(){
	int marks;
	cout<<"Enter the Marks of the Student = ";
	cin>>marks;
	
	if(marks<0){
		cout<<"Invalid Output!";
	}
	if(marks>=90 && marks <= 100){
		cout<<"GRADE:- A"<<endl;
	}else if(marks>=80 && marks<=89){
		cout<<"GRADE:- B"<<endl;
	}else if(marks>=70 && marks<=79){
		cout<<"GRADE:- C"<<endl;
	}else if(marks>=60 && marks<=69){
		cout<<"GRADE:- D"<<endl;
	}else{
		cout<<"GRADE:- F"<<endl;
	}
	return 0;
}
