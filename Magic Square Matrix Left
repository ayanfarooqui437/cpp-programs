#include<iostream>
#include<vector>

using namespace std;

void SquareMagicMatrix(int n){
	vector<vector<int> > matrix(n, vector<int>(n,0));
	
	int i = 0;
	int j = n / 2;
	
	for(int num = 1; num <= n*n; num++){
		matrix[i][j] = num;
		int r = (i - 1 + n) % n;
		int c = (j - 1 + n) % n;
		
		if(matrix[r][c] != 0){
			i = (i + 1) % n;
		}else{
			i = r;
			j = c;
		}
	}
	
	cout<<"Magic Square Matrix is: "<<endl;
	for(int i  = 0; i < n; i++){
		cout<<"[ ";
		for(int j = 0; j < n; j++){
			cout<<matrix[i][j]<<" ";
		}
		cout<<"]";
		cout<<endl;
	}
}

//Main Function
int main(){
	int number;
	cout<<"Enter the Size of the Magic ODD Square Matrix :- ";
	cin>>number;
	
	if(number <= 0 || number % 2 == 0){
		cout<<"Please Enter a Positive ODD number for the Magic Matrix. "<<endl;
		return 0;
	}
	SquareMagicMatrix(number);
	return 0;
}
