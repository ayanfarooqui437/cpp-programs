/* Write a program in to demonstrate parameterized/constructor overloading. Create a class calculator that contains four data members it. Initialize data members
with different values using a parameterized constructor and perform various arithmetic operations over these values and display results on the computer screen.*/
#include<iostream>
using namespace std;
class Arithmetic{
	private:
		int a;
		int b;
		int c;
		int d;
	public:
		//First Constructor
		Arithmetic(int num1, int num2, int num3, int num4){
			a = num1;
			b = num2;
			c = num3;
			d = num4;
		}
		//Another Constructor
		Arithmetic(int num1, int num2){
			a = num1;
			b = num2;
			c = 0;
			d = 0;
		}
		void Perform_Operations(){
			cout << "Addition:- " << a + b + c + d<< endl;
			cout << "Subtraction:- " << a - b - c - d<< endl;
			cout << "Multiplication:- " << a * b * c * d<< endl;
			if(b != 0 && c != 0 && d != 0){
				cout << "Division:- " << (float) a / b / c / d << endl;
			}else{
				cout << "Invalid Input!" << endl;
			}
		}
};
int main(){
	Arithmetic A(12, 23, 34, 45);
	A.Perform_Operations();
	cout << "-------------Constructor Overloading-------------" << endl;
	Arithmetic B(12, 23);
	B.Perform_Operations();
	return 0;
}
