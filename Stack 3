#include <iostream>
#include <stack>
using namespace std;

bool balanced(string exp)
{
    stack<char> s;

    for (int i = 0; i < exp.length(); i++)
    {
    	char ch = exp[i];
        if(ch == '(' || ch == '{' || ch == '[')
            s.push(ch);

        else if(ch == ')' || ch == '}' || ch == ']')
        {
            if(s.empty())
                return false;

            if((ch == ')' && s.top() != '(') ||
               (ch == '}' && s.top() != '{') ||
               (ch == ']' && s.top() != '['))
                return false;

            s.pop();
        }
    }

    return s.empty();
}

int main()
{
    string exp;
    cin >> exp;

    if(balanced(exp))
        cout << "Balanced";
    else
        cout << "Not Balanced";
}
