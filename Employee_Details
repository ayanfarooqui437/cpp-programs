/*Write a C++ program to compute the monthly pay of 100 employees using each
employee's name, basic pay. The DA is calculated as 52% Of the basic pay. Gross-salary
(basic pay DA). Print the employee's name and gross salary.*/

#include<iostream>
#include<string>

using namespace std;

struct Employee{
	string name;
	float basic_pay;
	float DA;
	float gross_salary;
};

int main(){
	Employee emp[100];
	
	int num;
	cout<<"Enter the Number of the Employee:- ";
	cin>>num;
	
	for(int i = 0; i  < num; i++){
		cout<<"Enter the Details of the Employee "<<i + 1<<endl;
		cout<<"Name:- ";
		cin.ignore();
		getline(cin, emp[i].name);
		
		cout<<"Basic Pay:- ";
		cin>>emp[i].basic_pay;
		
		emp[i].DA = 0.25 * emp[i].basic_pay;
		emp[i].gross_salary = emp[i].DA + emp[i].basic_pay;
	}
	
	cout<<"=========EMPLOYEE'S DETAILS==========="<<endl;
	for(int i = 0; i < num; i++){
		cout<<"Name:- "<<emp[i].name<<endl;
		cout<<"Gross Salary:- "<<emp[i].gross_salary<<endl;
	}
	return 0;
}
