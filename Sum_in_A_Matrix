#include<iostream>
#include<vector>
#include<algorithm>

using namespace std;

class Solution{
	public:
		int sum_in_a_matrix(vector<vector<int> >& nums){
			int rows = nums.size();
			int cols = nums[0].size();
			//Sorting each row in the Descending order.
			for(int i = 0; i < rows; i++){
				sort(nums[i].rbegin(), nums[i].rend());
			}
			int score = 0;
			//Tranverse each column and Find the Maximum Element of each column.
			for(int j = 0;  j < cols; j++){
				int max_step = 0;
				for(int i = 0; i < rows; i++){
					max_step = max(max_step, nums[i][j]);
				}
				score = score + max_step;
			}
			return score;	
		}
};
//Main Function
int main(){
	Solution sol;
	int rows, cols;
	cout<<"Enter the Size of the Rows:- ";
	cin>> rows;
	cout<<"Enter the Size of the Columns:- ";
	cin>>cols;
	
	//Initialzing the Matrix with Vector
	vector<vector<int> > matrix(rows, vector<int>(cols));
	cout<<"Enter the Elements of the Matrix:- "<<endl;
	for(int i = 0; i < rows; i++){
		for(int j = 0; j <  cols; j++){
			cout<<"Enter the ["<<i<<"]["<<j<<"] element of the Matrix:- ";
			cin>> matrix[i][j];
		}
	}
	cout<<"Matrix:- "<<endl;
	for(int i = 0; i < rows; i++){
		cout<<"[ ";
		for(int j = 0; j < cols; j++){
			cout<<matrix[i][j]<<" ";
		}
		cout<<"]";
		cout<<endl;
	}
	int finalscore = sol.sum_in_a_matrix(matrix);
	cout<<"Final Score:- "<<finalscore<<endl;
	return 0;
}
