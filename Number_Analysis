#include <iostream>
using namespace std;

int main() {
    int num;
    cout << "Enter the Number = ";
    cin >> num;

    if(num < 0){
        cout << "Number is Negative.";
    }
    else if(num == 0){
        cout << "Number is Zero.";
    }
    else{
        int temp = num;
        int sum = 0, digit;

        // Sum of digits
        while(temp > 0){
            digit = temp % 10;
            sum += digit;
            temp /= 10;
        }

        cout << "Sum of the Digits = " << sum << endl;

        // Count digits using array
        temp = num;
        int arr[20];
        int count = 0;

        while(temp > 0){
            arr[count] = temp % 10;
            temp /= 10;
            count++;
        }
        cout << "Count of Digits = " << count << endl;
        
        //Find the Largest Number
        int largest = arr[0];
        for(int i = 0; i<count;i++){
        	if(arr[i]>largest){
        		largest = arr[i];
			}
		}
		cout<<"Largest Digit is "<<largest<<endl;
		
		// Check for Palindrome
		int original_num = num;
		int reversed_num = 0;
		while(num > 0){
		digit = num % 10;
		reversed_num = reversed_num * 10 + digit;
		num = num / 10;
		}
		if(original_num == reversed_num){
		cout << "The Number is Palindrome." << endl;
		}
		else{
		cout << "The Number is Not Palindrome." << endl;
		}
    }
    return 0;
}
