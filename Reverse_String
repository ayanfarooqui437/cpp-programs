#include<iostream>
#include<string>
using namespace std;
int main(){
	string name,reverse_name = "",original_name;
	cout<<"Enter the name: ";
	getline(cin,name);
	
	original_name = name;
	
	int n = name.length();
	for(int i = n; i>=0; i--){
		reverse_name = reverse_name + name[i];
	}
	cout<<"Reverse of the Name is "<<reverse_name<<endl;
	
	return 0;
}
