//Linked List Polynomial
#include<iostream>

using namespace std;

class Node{
	public:
		int coeff;
		int expX;
		int expY;
		Node *next;
		
		Node(int c, int x, int y){
			coeff = c;
			expX = x;
			expY = y;
			next = NULL;
		}
		
		void display(Node *head){
			while(head != NULL){
				cout << head->coeff <<"x^"<< head->expX <<"y^"<< head->expY;
				head = head->next;
				if(head != NULL){
					cout << " + ";
				}
			}
		}
};

int main(){
	Node *head = new Node(9,3,2);
	head->next= new Node(-8,2,2);
	head->next->next = new Node(10,1,1);
	head->next->next->next = new Node(3,0,2);
	
	cout<<"Polynomial = ";
	head->display(head);
	
	return 0;
}
