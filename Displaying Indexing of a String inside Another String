//Write a C++ program that displays the position or indexin the string S where the string T begins, or 1 if S doesn't contain T.
#include<iostream>
#include<string>

using namespace std;

int main(){
	string S, T;
	
	cout << "Enter the S string:- ";
	getline(cin, S);
	
	cout << "Enter the T string:- ";
	getline(cin, T);
	
	int position = S.find(T);
	
	if(position != string::npos){
		cout << "Position:- " << position << endl;
	}else{
		cout << "1" << endl;
	}
	return 0;
}
