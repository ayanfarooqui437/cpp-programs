// Write a C++ program to determine whether the given string is a palindrome
#include<iostream>
#include<string>
using namespace std;
int main(){
	string name, original_name, reverse_name = "";
	
	cout<<"Enter the Name of the Person: ";
	cin>>name;
	
	original_name = name;
	
	int n = name.length();
	
	//Loop
	for(int i = n - 1; i >= 0; i--){
		reverse_name = reverse_name + name[i];
	}
	
	//Conditional Statement
	if(original_name == reverse_name){
		cout<<"The String is PALINDROME. ";
	}else{
		cout<<"The String is not PALINDROME. ";
	}
	
	return 0;
}
