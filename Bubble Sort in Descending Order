//Bubble Sort in Descending Order
#include<iostream>

using namespace std;

int main(){
	int a[5], temp;
	
	cout << "Enter the Elements:- ";
	for(int i = 0; i < 5; i++){
		cin >> a[i];
	}
	
	for(int i = 0; i < 5; i++){
		for(int j = 0; j < 4 - i; j++){
			if(a[j] < a[j + 1]){
				temp = a[j];
				a[j] = a[j + 1];
				a[j + 1] = temp;
			}
		}
	}
	
	cout << "Sorted Array:- [";
	for(int i = 0; i < 5; i++){
		cout << a[i] << " ";
	}
	cout << "]";
	return 0;
}
