#include<iostream>
using namespace std;

int main(){
	int rows,cols;
	
	cout<<"Enter the Number of Rows = ";
	cin>>rows;
	
	cout<<"Enter the Number of Columns = ";
	cin>>cols;
	
	int A[rows][cols];
	
	cout<<"Enter the Elements of Matrix: ";
	cout<<endl;
	for(int i = 0; i<rows; i++){
		for(int j = 0; j<cols; j++){
			cout<<"Enter the ["<<i<<"]["<<j<<"] Element of the Matrix: ";
			cin>>A[i][j];
		}
	}
	
	cout<<"The Matrix is: ";
	for(int i = 0; i<rows; i++){
		cout<<"[ ";
		for(int j = 0; j<cols; j++){
			cout<<A[i][j]<<" ";
		}
		cout<<" ]";
	}
	cout<<endl;
	//SPIRAL_MATRIX
	int left = 0;
	int top = 0;
	int right = cols - 1;
	int bottom = rows - 1;
	//Logic_Starts_Here
	cout<<"Matrix After Being Spiral: ";
	while(top <= bottom && left <= right){
		//Loop 1(lEFT-TO-RIGHT)
		for(int i = left; i <= right; i++){
			cout<<A[top][i]<<" ";
		}
		top++;
		
		//Loop 2(TOP-TO-BOTTOM)
		for(int j = top; j <= bottom; j++){
			cout<<A[j][right]<<" ";
		}
		right--;
		
		//Conditional Statement 1
		if(top <= bottom){
			//Loop 3(RIGHT-TO-LEFT)
			for(int k = right; k >= left; k--){
				cout<<A[bottom][k]<<" ";
			}
			bottom--;
		}
		
		//Conditional Statement 2
		if(left <= right){
			//Loop 4(BOTTOM-TO-TOP)
			for(int g = bottom; g >= top; g--){
				cout<<A[g][left]<<" ";
			}
			left++;
		}
	}
	return 0;
}
