//Linked_List_Heterogenous_List
#include<iostream>

using namespace std;

union Data{
	int i; 
	float f;
	char c;
};

class Node{
	public:
		Data data;
		int type;
		Node *next;
		
		Node(int value){
			data.i = value;
			type = 1;
			next = NULL;
		}
		
		Node(float value){
			data.f =value;
			type = 2;
			next = NULL;
		}
		
		Node(char value){
			data.c = value;
			type = 3;
			next = NULL;
		}
		
		void display(Node *head){
			while(head != NULL){
				if(head->type == 1){
					cout << head->data.i <<" ";
				}else if(head->type == 2){
					cout << head->data.f  <<" ";
				}else{
					cout << head->data.c <<" ";
				}
				head = head->next;
			}
		}
};

int main(){
	Node *head = new Node(10);
	head->next = new Node(5.5f);
	head->next->next = new Node('A');
	head->next->next->next = new Node(10);
	
	cout<<"Heterogenous Linked List = ";
	head->display(head);
	
	return 0;
}
