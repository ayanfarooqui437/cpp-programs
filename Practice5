#include<iostream>
using namespace std;
int main(){
	//Skips the Multiple of 3
	for(int i = 1; i <= 50; i++){
		if(i % 3 == 0){
			continue;
		}
		cout<< i << " ";
	}
	cout<<endl;
	int num, sum = 0;
	cout << "Enter up to 100 integers: " << endl;
	for(int i = 1; i <= 100; i++){
		cin >> num;
		if(num < 0){
			break;
		}
		sum = sum + num;
	}
	cout<<"Sum = "<<sum<<endl;
	return 0;
}
