#include<iostream>
#include<vector>

using namespace std;

void SquareMagicMatrix(int n){
	vector<vector<int> > matrix(n, vector<int>(n,0));
	
	int i = 0; //Starts from the First Row
	int j = n / 2; //Starts from the Middle of the Column
	
	for(int num = 1; num <= n*n; num++){   //Places Elements from 1 to n*n
	
		matrix[i][j] = num;
		
		int r = (i - 1 + n) % n;  //Calculates the Row Above, Wrapping around if Necessary
		int c = (j + 1) % n;      //Calculated the Column to the Right, Wrapping around if Necessary
		
		if(matrix[r][c] != 0){    //Check whether the Next Position is Occupied or Not. 
			i = (i + 1) % n;      //Moves Down, If the Next Diagonal Position is occupied.
		}else{
			i = r;				  //Moves Diagonally Up and Right if the Position is Empty.
			j = c;
		}
	}
	
	cout<<"Magic Square Matrix is : "<<endl;
	for(int i = 0; i < n; i++){
		cout<<"[ ";
		for(int j = 0; j < n; j++){
			cout<<matrix[i][j]<<" ";
		}
		cout<<"]";
		cout<<endl;
	}
}

// Main Function
int main(){
	int number;
	
	cout<<"Enter the Size of the ODD Matrix :- ";
	cin>>number;
	
	if(number <= 0 || number % 2 == 0){
		cout<<"Please Enter A Positive ODD Matrix."<<endl;
		return 0;
	}
	
	SquareMagicMatrix(number);
	return 0;
}
